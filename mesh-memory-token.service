[Unit]
Description=Mesh-Memory Token Lifecycle Service
After=network.target

[Service]
Type=simple
User=%h
WorkingDirectory=%h/.openclaw/workspace/projects/mesh-memory
ExecStart=/usr/bin/bun run token-lifecycle.mjs
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.openclaw/workspace/memory/mesh

[Install]
WantedBy=default.target
