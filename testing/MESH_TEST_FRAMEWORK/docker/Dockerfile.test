# Test Docker Image for mesh-memory
# Provides a containerized environment for running integration tests

FROM node:22-slim

# Install dependencies for testing
RUN apt-get update && apt-get install -y \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application
COPY . .

# Create test directories
RUN mkdir -p /data/memory/mesh /data/memory/shared /data/memory/threads

# Set environment variables
ENV NODE_ENV=test
ENV MESH_STORAGE_DIR=/data
ENV TEST_MODE=true

# Health check endpoint
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:18801/health || exit 1

# Default command - can be overridden in docker-compose
CMD ["npm", "test"]
