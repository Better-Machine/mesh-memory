[Unit]
Description=Mesh-Memory Memory Bridge (LCM Export)
After=network.target

[Service]
Type=simple
User=%h
WorkingDirectory=%h/.openclaw/workspace/projects/mesh-memory
ExecStart=/usr/bin/node memory-bridge.mjs
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening - Phase 4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.openclaw/workspace/memory %h/.openclaw/workspace/memory/mesh %h/.openclaw/agents/main/sessions

# Phase 4: Extended hardening
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectClock=true
PrivateDevices=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGid=true
ProtectKernelLogs=true

[Install]
WantedBy=default.target
